<?xml version="1.0"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         backupGlobals="false"
         colors="true"
         bootstrap="tests/php/core/bootstrap.php">

    <php>
        <const name="WP_TESTS_MULTISITE" value="1" />
    </php>

    <testsuites>
        <testsuite name="Tests ported from WordPress core">
            <directory suffix=".php">modules/*/tests/core</directory>
        </testsuite>
    </testsuites>

    <groups>
        <exclude>
            <group>ms-excluded</group>
        </exclude>
    </groups>
</phpunit>
